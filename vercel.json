{
  "functions": {
    "api/**/*.js": {
      "includeFiles": [
        "MM2026_pistelaskenta.xlsx",
        "tulokset.txt"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/agent-analysis-html",
      "destination": "/api/agent-analysis-html"
    },
    {
      "source": "/agent-analysis.json",
      "destination": "/api/agent-analysis"
    },
    {
      "source": "/botmanen-summary.json",
      "destination": "/api/botmanen-summary"
    },
    {
      "source": "/live-games.json",
      "destination": "/api/live-games"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version"
        }
      ]
    },
    {
      "source": "/agent-analysis-html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/agent-analysis.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/botmanen-summary.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/live-games.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60"
        }
      ]
    }
  ]
}
